{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading studio session context"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/detect-gaps.sh\"",
            "timeout": 10,
            "statusMessage": "Checking project gaps"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-commit.sh\"",
            "timeout": 10,
            "statusMessage": "Checking staged commit"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-push.sh\"",
            "timeout": 10,
            "statusMessage": "Reviewing push target"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-assets.sh\"",
            "timeout": 10,
            "statusMessage": "Reviewing changed assets"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-skill-change.sh\"",
            "timeout": 10,
            "statusMessage": "Validating Codex contracts"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-stop.sh\"",
            "timeout": 10,
            "statusMessage": "Writing session audit trail"
          }
        ]
      }
    ]
  }
}
